# ========================================================
# COLISEU ARENA • VARIÁVEIS DE AMBIENTE (VERCEL & PRODUÇÃO)
# ========================================================

# 1. Banco de Dados Serverless (Turso / LibSQL)
# Crie seu banco gratuitamente em https://turso.tech com:
#   turso db create coliseu-arena
#   turso db show coliseu-arena --url
#   turso db tokens create coliseu-arena
TURSO_DATABASE_URL=libsql://coliseu-arena-seu-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_jwt_do_turso

# 2. Login com o Google (Google Identity Services)
# Obtenha em https://console.cloud.google.com/apis/credentials
# Adicione o domínio da Vercel (ex: https://coliseu-arena.vercel.app) em "Origens JavaScript autorizadas"
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# 3. Senha de Acesso Exclusiva do Juiz / Organizador (TO)
JUDGE_PASSWORD=defina_uma_senha_forte_aqui

# 4. Porta do Servidor (apenas desenvolvimento local ou VPS)
PORT=3001
